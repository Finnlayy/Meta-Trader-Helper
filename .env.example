# .env.example — local configuration for Fable 5 Intelligence Terminal.
# Optional: when DATABASE_URL is omitted, Fable 5 persists locally via embedded PGlite (.fable5/pgdata).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fable5

# Optional: MetaAPI Cloud credentials for MT4/MT5 synchronization
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Optional: Built-in MetaTrader 5 & MetaEditor Local MCP Servers (Tools -> Options -> MCP)
# Used when running Fable 5 locally alongside MetaTrader 5 on the same machine
MT5_MCP_URL=http://127.0.0.1:22346/mcp
MT5_MCP_TOKEN=
METAEDITOR_MCP_URL=http://127.0.0.1:22345/mcp
METAEDITOR_MCP_TOKEN=

# Optional: OpenAI API key for F7 Copilot external completion (falls back cleanly to deterministic local quant brief)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
